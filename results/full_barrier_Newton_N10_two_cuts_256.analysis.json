  "source_snapshot_utf8": {
    "/home/shiqiu/s-matrix-bootstrap/scripts/analyze_newton_spectral_and_mu.py": "\"\"\"Read-only spectral partition and best local barrier parameter from saved H/g.\"\"\"\nimport argparse\nfrom fractions import Fraction as F\nimport gzip\nimport hashlib\nimport json\nfrom pathlib import Path\nimport time\n\n\ndef digest(path):return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef main():\n    from flint import arb,arb_mat,ctx\n    from smatrix_bootstrap.julia_bridge import _decode_csc,decode_float64_bits\n    from smatrix_bootstrap.primal_barrier import ExactEqualityCoordinates\n    parser=argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('report',type=Path)\n    parser.add_argument('--output',type=Path,required=True)\n    args=parser.parse_args();start=time.monotonic()\n    if args.output.exists():raise FileExistsError('Use a new immutable analysis output')\n    report=json.loads(args.report.read_text());r=report['result']\n    if r['status']!='validated_full_Newton_system':raise ValueError('A validated full system is required')\n    for name in ['input','seed']:\n        if digest(report[name+'_path'])!=report[name+'_sha256']:raise ValueError(name+' hash mismatch')\n    for name,source in report['source_snapshot_utf8'].items():\n        if hashlib.sha256(source.encode()).hexdigest()!=report['source_sha256'][name]:raise ValueError('Source snapshot hash mismatch')\n    spec=report['system_enclosures'];path=Path(spec['path'])\n    if digest(path)!=spec['sha256']:raise ValueError('System hash mismatch')\n    system=json.loads(gzip.decompress(path.read_bytes()));seed=json.loads(Path(report['seed_path']).read_text())\n    payload=json.loads(Path(report['input_path']).read_text())\n    source=json.loads(Path(seed['source_seed']).read_text())\n    if digest(seed['source_seed'])!=seed['source_seed_sha256']:raise ValueError('Source variable-map hash mismatch')\n    rho=next(v for v in source['original_variable_map'] if v['name']=='rho_over_k_squared')\n    E=_decode_csc(payload['A']).tocsr()[:payload['cones']['zero']].toarray()\n    eq=ExactEqualityCoordinates(E,decode_float64_bits(payload['b'])[:len(E)],\n        rank=seed['equality_rank'],rows=seed['equality_rows'],pivot_columns=seed['pivot_columns'],pivot_inverse=seed['pivot_inverse'])\n    free=eq.free\n    if free!=r['equality']['free_columns']:raise ValueError('Exact nullspace coordinate order differs')\n    selected=[i for i,j in enumerate(free) if rho['offset']<=seed['current_to_original_columns'][j]<rho['offset']+rho['size']]\n    if len(selected)!=86:raise ValueError('Expected all86 retained spectral coordinates')\n    qold=[F.from_float(float(v)) for v in decode_float64_bits(payload['q'])]\n    qexact=[qold[j]+sum((eq.pivot_null[k][i]*qold[p] for k,p in enumerate(eq.pivots)),F(0)) for i,j in enumerate(free)]\n    if any(qexact[i] for i in selected):raise ValueError('Spectral objective is not identically zero')\n    old=ctx.prec\n    try:\n        ctx.prec=256\n        def ball(v):v=F(v);return arb(v.numerator)/v.denominator\n        def enclosure(v):\n            lo,hi=map(F,v)\n            if lo>hi:raise ValueError('Reversed interval')\n            return ball((lo+hi)/2)+arb(0,ball((hi-lo)/2).upper())\n        def interval(v):return dict(lower_rational=str(v.lower().fmpq()),upper_rational=str(v.upper().fmpq()),ball=str(v))\n        n=system['dimension'];H=arb_mat(n,n);k=0\n        for i in range(n):\n            for j in range(i+1):H[i,j]=H[j,i]=enclosure(system['Hessian_lower_triangle_bounds'][k]);k+=1\n        g=arb_mat([[enclosure(v)] for v in system['gradient_bounds']])\n        p=arb_mat([[enclosure([v['lower_rational'],v['upper_rational']])] for v in r['free_direction_enclosures']])\n        lam=-(g.transpose()*p)[0,0]\n        Hrr=arb_mat([[H[i,j] for j in selected] for i in selected]);gr=arb_mat([[g[i,0]] for i in selected])\n        conditional=(gr.transpose()*Hrr.solve(gr))[0,0];remaining=lam-conditional\n        q=arb_mat([[ball(v)] for v in qexact]);mu0=ball(system['mu_rational'])\n        f=g-q/mu0\n        rhs=arb_mat([[q[i,0],f[i,0]] for i in range(n)])\n        inverse_rhs=H.solve(rhs)\n        a=sum((q[i,0]*inverse_rhs[i,0] for i in range(n)),arb(0))\n        b=sum((q[i,0]*inverse_rhs[i,1] for i in range(n)),arb(0))\n        c=sum((f[i,0]*inverse_rhs[i,1] for i in range(n)),arb(0))\n        if not a>0:raise ArithmeticError('Positive objective-direction curvature was not proved')\n        current_from_fit=a/mu0**2+2*b/mu0+c\n        fit=dict(a=interval(a),b=interval(b),c=interval(c),\n            defining_quadratic='lambda\u00b2(t)=a*t\u00b2+2*b*t+c, t=1/mu; the point and full H stay fixed',\n            current_lambda_squared_reconstructed=interval(current_from_fit),\n            reconstruction_minus_full_lambda=interval(current_from_fit-lam),\n            objective_scale_power=seed['objective_scale_power'],mu0_rational=system['mu_rational'])\n        if b<0:\n            best=-a/b;minimum=c-b*b/a\n            fit.update(status='positive_finite_minimizer_certified',mu_best=interval(best),\n                t_best=interval(-b/a),minimum_lambda_squared=interval(minimum),\n                minimum_lambda_squared_proved_below_one=bool(minimum<1),\n                minimum_lambda_squared_proved_above_one=bool(minimum>1))\n        elif b>=0:\n            fit.update(status='infimum_as_mu_tends_to_infinity',minimum_lambda_squared=interval(c),\n                minimum_lambda_squared_proved_below_one=bool(c<1),minimum_lambda_squared_proved_above_one=bool(c>1))\n        else:fit.update(status='sign_of_b_unresolved')\n        residual=H*inverse_rhs-rhs\n        out=dict(schema='smatrix-fixed-point-Newton-spectral-mu-analysis-v1',\n            report=str(args.report),report_sha256=digest(args.report),system_path=str(path),system_sha256=spec['sha256'],\n            input_sha256=report['input_sha256'],seed_sha256=report['seed_sha256'],precision_bits=256,\n            full_coordinate_count=n,spectral_free_coordinate_count=len(selected),spectral_indices=selected,\n            exact_projected_objective_rational=list(map(str,qexact)),full_lambda_squared=interval(lam),\n            spectral_conditional_decrement_squared=interval(conditional),\n            remaining_Schur_complement_decrement_squared=interval(remaining),\n            spectral_fraction_of_full_decrement=interval(conditional/lam),local_mu_fit=fit,\n            additional_rhs_solve_residual_contains_zero=all(residual[i,j].contains(0) for i in range(n) for j in range(2)),\n            additional_rhs_solve_residual_infinity_upper=str(max(abs(residual[i,j]).upper() for i in range(n) for j in range(2)).fmpq()),\n            full_Hessian_reassembled=False,primal_point_moved=False,optimization_performed=False,\n            precision_retry_performed=False,elapsed_seconds=time.monotonic()-start,\n            scope='Validated linear algebra on the SAME complete archived H/g. The mu fit diagnoses local centrality of the fixed point; it is not a phase fit, new physical model, optimization run or optimum certificate.',\n            source_snapshot_utf8={str(Path(__file__)):Path(__file__).read_text()})\n        out['source_sha256']={k:hashlib.sha256(v.encode()).hexdigest() for k,v in out['source_snapshot_utf8'].items()}\n        args.output.write_text(json.dumps(out,indent=2)+'\\n')\n        print(json.dumps({k:v for k,v in out.items() if k not in ['exact_projected_objective_rational','source_snapshot_utf8','spectral_indices']},indent=2))\n    finally:ctx.prec=old\n\n\nif __name__=='__main__':main()\n"
  },
