  "source_snapshot_utf8": {
    "/home/shiqiu/s-matrix-bootstrap/scripts/audit_gauge_duality.py": "\"\"\"Exact residual-product audit of captured linear gauge conic iterates.\"\"\"\nimport argparse\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport mpmath as mp\n\nfrom smatrix_bootstrap.conic_residuals import (dyadic_from_bits,add_dyadics,\n    subtract_dyadics,as_mpf,dot_dyadics,exact_kkt_terms,numerical_cone_audit)\n\n\ndef vector(bits):return list(map(dyadic_from_bits,bits))\n\n\ndef norm2(values):return mp.sqrt(as_mpf(dot_dyadics(values,values)))\n\n\ndef serialize(value):\n    n,e=value\n    return dict(integer=str(n),power_of_two=e,decimal=mp.nstr(as_mpf(value),70))\n\n\ndef summarize(data,native,values,label,*,x=None,s=None,z=None):\n    b,c=vector(data['b']),vector(data['q'])\n    x=vector(native['x']) if x is None else x\n    s=vector(native['s']) if s is None else s\n    z=vector(native['z']) if z is None else z\n    terms=exact_kkt_terms(data['A'],values,b,c,x,s,z)\n    if terms['identity_remainder'][0]:raise ArithmeticError('Exact weak-duality identity failed')\n    rp,rd=terms['primal_residual'],terms['dual_residual']\n    rpn,rdn=norm2(rp),norm2(rd);xn,sn,zn=norm2(x),norm2(s),norm2(z)\n    variables=[]\n    for spec in native['original_variable_slices'].values():\n        a=spec['offset'];k=a+spec['size']\n        variables.append(dict(name=spec['name'],shape=spec['shape'],\n            x_norm2=str(norm2(x[a:k])),dual_residual_norm2=str(norm2(rd[a:k])),\n            signed_x_dot_rd=serialize(dot_dyadics(x[a:k],rd[a:k]))))\n    variables.sort(key=lambda r:abs(mp.mpf(r['signed_x_dot_rd']['decimal'])),reverse=True)\n    return dict(label=label,reported_solver_info=native['reported_solver_info'],\n        exact_identity={k:serialize(terms[k]) for k in ['gap','complementarity','dual_residual_product',\n            'primal_residual_product','absolute_dual_residual_product_sum','absolute_primal_residual_product_sum','identity_remainder']},\n        residuals=dict(primal_l2=str(rpn),dual_l2=str(rdn),\n            primal_inf=str(max(abs(as_mpf(v)) for v in rp)),dual_inf=str(max(abs(as_mpf(v)) for v in rd)),\n            normalized_primal=str(rpn/max(1,norm2(b)+xn+sn)),\n            normalized_dual=str(rdn/max(1,norm2(c)+xn+zn))),\n        iterate_norms=dict(x_l2=str(xn),s_l2=str(sn),z_l2=str(zn),b_l2=str(norm2(b)),c_l2=str(norm2(c))),\n        native_primal_cone=numerical_cone_audit(s,data['cones']),\n        effective_primal_cone=numerical_cone_audit(terms['effective_slack'],data['cones']),\n        dual_cone=numerical_cone_audit(z,data['cones'],dual=True),\n        original_variable_contributions=variables,\n        exact_linear_algebra=True,cone_checks_are_rigorous=False)\n\n\ndef main():\n    p=argparse.ArgumentParser(description=__doc__)\n    p.add_argument('--prefix',type=Path,default=Path('results/gauge_duality_N6'))\n    p.add_argument('--output',type=Path,default=Path('results/gauge_duality_N6_audit.json'))\n    args=p.parse_args();mp.mp.dps=100\n    labels=['margin','mixed100','support'];data=[];native=[];files=[]\n    for label in labels:\n        a=Path(str(args.prefix)+'_'+label+'.conic.json');b=Path(str(args.prefix)+'_'+label+'.native.json')\n        data.append(json.loads(a.read_text()));native.append(json.loads(b.read_text()));files.extend([a,b])\n        if data[-1]['P']['data']:raise ValueError('Audit requires a linear conic objective')\n        if hashlib.sha256(a.read_bytes()).hexdigest()!=native[-1]['input_sha256']:\n            raise ValueError('Input hash disagrees with native snapshot')\n    if not all(d['A']==data[0]['A'] and d['cones']==data[0]['cones'] for d in data):\n        raise ValueError('Cross-stage comparison requires identical original conic matrices/cones')\n    values=vector(data[0]['A']['data'])\n    report=dict(prefix=str(args.prefix),matrix_and_cones_identical=True,mpmath_digits=100,\n        input_sha256={str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in files},records=[],\n        scope='Exact dyadic linear KKT products plus high-precision numerical cone checks. No physical-operator, exact-feasibility, or optimality certificate.')\n    for label,d,n in zip(labels,data,native):\n        result=summarize(d,n,values,label)\n        report['records'].append(result)\n        print(json.dumps(dict(label=label,gap=result['exact_identity']['gap']['decimal'],\n            rp_l2=result['residuals']['primal_l2'],rd_l2=result['residuals']['dual_l2'],\n            x_rd=result['exact_identity']['dual_residual_product']['decimal'],\n            rp_z=result['exact_identity']['primal_residual_product']['decimal'])),flush=True)\n    b0,b1=vector(data[0]['b']),vector(data[1]['b'])\n    shift=[subtract_dyadics(a,b) for a,b in zip(b0,b1)]\n    mapped=[add_dyadics([s,delta]) for s,delta in zip(vector(native[1]['s']),shift)]\n    combined={**native[1],'reported_solver_info':native[0]['reported_solver_info']}\n    cross=summarize(data[0],combined,values,'mixed100_primal_against_margin_dual',\n        x=vector(native[1]['x']),s=mapped,z=vector(native[0]['z']))\n    cross['rhs_shift_nonzero']=[dict(row=i,change=serialize(v)) for i,v in enumerate(shift) if v[0]]\n    report['cross_stage']=cross\n    source_paths=[Path(__file__),Path('src/smatrix_bootstrap/conic_residuals.py')]\n    report['source_snapshot_utf8']={str(p):p.read_text() for p in source_paths}\n    report['source_sha256']={str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in source_paths}\n    args.output.write_text(json.dumps(report,indent=2)+'\\n')\n    print(json.dumps(dict(label=cross['label'],terms={k:v['decimal'] for k,v in cross['exact_identity'].items()})),flush=True)\n\n\nif __name__=='__main__':main()\n",
    "src/smatrix_bootstrap/conic_residuals.py": "\"\"\"Exact dyadic residual products for a linear conic problem.\n\nOriginal IEEE754 inputs/iterates are finite dyadic rationals. Matrix-vector\nproducts and the perturbed weak-duality identity are evaluated exactly with\nintegers; numerical cone eigenvalues/norms are reported separately.\n\"\"\"\nimport struct\n\nimport mpmath as mp\n\n\ndef dyadic_from_bits(bits):\n    value=struct.unpack('>d',bytes.fromhex(bits))[0]\n    n,d=value.as_integer_ratio()\n    return n,-(d.bit_length()-1)\n\n\ndef dyadic_from_float(value):\n    n,d=float(value).as_integer_ratio()\n    return n,-(d.bit_length()-1)\n\n\ndef add_dyadics(values):\n    values=[(n,e) for n,e in values if n]\n    if not values:return 0,0\n    exponent=min(e for _,e in values)\n    return sum(n<<(e-exponent) for n,e in values),exponent\n\n\ndef dot_dyadics(left,right,absolute_products=False):\n    return add_dyadics(((abs(a*b) if absolute_products else a*b),e+f)\n                       for (a,e),(b,f) in zip(left,right))\n\n\ndef subtract_dyadics(left,right):\n    return add_dyadics([left,(-right[0],right[1])])\n\n\ndef as_mpf(value):\n    n,e=value\n    return mp.mpf(n)*mp.power(2,e)\n\n\ndef csc_products(matrix,values,x,z):\n    \"\"\"Compute A*x and A.T*z exactly using one common exponent per product.\"\"\"\n    ea=min((e for n,e in values if n),default=0)\n    ex=min((e for n,e in x if n),default=0)\n    ez=min((e for n,e in z if n),default=0)\n    ax=[0]*matrix['shape'][0];atz=[0]*matrix['shape'][1]\n    for j,(xn,xe) in enumerate(x):\n        for k in range(matrix['indptr'][j],matrix['indptr'][j+1]):\n            i=matrix['indices'][k];an,ae=values[k];zn,ze=z[i]\n            if an and xn:ax[i]+=(an*xn)<<(ae+xe-ea-ex)\n            if an and zn:atz[j]+=(an*zn)<<(ae+ze-ea-ez)\n    return [(n,ea+ex) for n in ax],[(n,ea+ez) for n in atz]\n\n\ndef exact_kkt_terms(matrix,values,b,c,x,s,z):\n    \"\"\"For rp=Ax+s-b, rd=A.T*z+c, gap=s.z+x.rd-rp.z exactly.\"\"\"\n    ax,atz=csc_products(matrix,values,x,z)\n    rp=[add_dyadics([a,si,(-bi[0],bi[1])]) for a,si,bi in zip(ax,s,b)]\n    rd=[add_dyadics([a,ci]) for a,ci in zip(atz,c)]\n    effective=[subtract_dyadics(bi,ai) for bi,ai in zip(b,ax)]\n    gap=add_dyadics([dot_dyadics(c,x),dot_dyadics(b,z)])\n    complement=dot_dyadics(s,z);primal_error=dot_dyadics(rp,z);dual_error=dot_dyadics(x,rd)\n    remainder=add_dyadics([gap,(-complement[0],complement[1]),\n                          (-dual_error[0],dual_error[1]),primal_error])\n    return dict(primal_residual=rp,dual_residual=rd,effective_slack=effective,\n        gap=gap,complementarity=complement,dual_residual_product=dual_error,\n        primal_residual_product=primal_error,identity_remainder=remainder,\n        absolute_dual_residual_product_sum=dot_dyadics(x,rd,True),\n        absolute_primal_residual_product_sum=dot_dyadics(rp,z,True))\n\n\ndef numerical_cone_audit(values,cones,dual=False):\n    \"\"\"mpmath cone checks in upper-column sqrt(2)-svec convention; not balls.\"\"\"\n    v=[as_mpf(x) for x in values];offset=0;blocks=[]\n    zero=cones['zero']\n    if zero:\n        blocks.append(dict(kind='zero_free_dual' if dual else 'zero',offset=0,size=zero,\n            signed_violation=mp.mpf(0) if dual else max(abs(x) for x in v[:zero])))\n    offset+=zero;n=cones['nonnegative']\n    if n:blocks.append(dict(kind='nonnegative',offset=offset,size=n,signed_violation=-min(v[offset:offset+n])))\n    offset+=n\n    for n in cones['soc']:\n        w=v[offset:offset+n]\n        blocks.append(dict(kind='soc',offset=offset,size=n,\n            signed_violation=mp.sqrt(mp.fsum(x*x for x in w[1:]))-w[0]))\n        offset+=n\n    for n in cones['psd']:\n        length=n*(n+1)//2;mat=mp.matrix(n);k=offset\n        for j in range(n):\n            for i in range(j+1):\n                mat[i,j]=mat[j,i]=v[k] if i==j else v[k]/mp.sqrt(2)\n                k+=1\n        minimum=mp.eigsy(mat,eigvals_only=True)[0]\n        blocks.append(dict(kind='psd',offset=offset,size=n,signed_violation=-minimum))\n        offset+=length\n    if cones.get('exponential') or cones.get('power') or offset!=len(v):\n        raise ValueError('Unsupported cone layout')\n    worst=max(blocks,key=lambda b:b['signed_violation'])\n    return dict(max_positive_violation=str(max(mp.mpf(0),worst['signed_violation'])),\n        worst_block={k:str(val) if isinstance(val,mp.mpf) else val for k,val in worst.items()},\n        minimum_cone_slack_excluding_equalities=str(-max(b['signed_violation'] for b in blocks if b['kind'] not in ('zero','zero_free_dual'))),\n        precision_digits=mp.mp.dps,rigorous_certificate=False)\n"
