t"}, 1, 1, [{"t": "Plain", "c": [{"t": "Str", "c": "E2–E3"}]}]], [["", [], []], {"t": "AlignDefault"}, 1, 1, [{"t": "Plain", "c": [{"t": "Str", "c": "三中心复验与同C相位；S0/P1两条近支撑全域排除"}]}]], [["", [], []], {"t": "AlignDefault"}, 1, 1, [{"t": "Plain", "c": [{"t": "Str", "c": "原文稳健定量ρ成功；整个D或所有原参数实现被排除"}]}]]]], [["", [], []], [[["", [], []], {"t": "AlignDefault"}, 1, 1, [{"t": "Plain", "c": [{"t": "Str", "c": "F1–F3"}]}]], [["", [], []], {"t": "AlignDefault"}, 1, 1, [{"t": "Plain", "c": [{"t": "Str", "c": "M50三组高精度完成，与原M45/M60组成五组；L差异稳定保留"}]}]], [["", [], []], {"t": "AlignDefault"}, 1, 1, [{"t": "Plain", "c": [{"t": "Str", "c": "M稳定性全部失败；全部Fig.3–11定量复现成功"}]}]]]]]]], [["", [], []], []]]}, {"t": "RawBlock", "c": ["tex", "\\clearpage"]}, {"t": "Para", "c": [{"t": "Strong", "c": [{"t": "Str", "c": "本轮可修补的实际数值问题已完成修补；当前明确有限原型的两个近支撑相位差异已获严格证书。论文稳健定量核心仍未完整复现。"}]}, {"t": "Space"}, {"t": "Str", "c": "这属于major，不是minor绘图、π分支或最后一次Newton未收敛的问题。原图的几MeV显示尺度差异属于较小比较误差，没有被用来改物理质量。"}]}, {"t": "Para", "c": [{"t": "Str", "c": "原文层面的结论仍须保持条件：尚未证明所有原参数实现不可能，也未证明论文错误；仍无法唯一判定缺失的作者约定、几何代表选择与论文数值报告之间哪一项负责。引入新范数、正则化、饱和等式或后续目标可以作为明确的新模型/新选择方案，但在取得来源依据前不能称作原2309的严谨修复。"}]}, {"t": "Header", "c": [2, ["来源与复核入口", [], []], [{"t": "Str", "c": "来源与复核入口"}]]}, {"t": "Para", "c": [{"t": "RawInline", "c": ["tex", "\\phantomsection"]}, {"t": "RawInline", "c": ["tex", "\\label{source-paper}"]}]}, {"t": "OrderedList", "c": [[1, {"t": "Decimal"}, {"t": "Period"}], [[{"t": "Para", "c": [{"t": "Str", "c": "He–Kruczenski,"}, {"t": "Space"}, {"t": "Str", "c": "2309.12402v3，"}, {"t": "Link", "c": [["", [], []], [{"t": "Str", "c": "原PDF"}], ["../../../../references/2309.12402v3.pdf", ""]]}, {"t": "Str", "c": "，§3–4及Appendix"}, {"t": "Space"}, {"t": "Str", "c": "A。基础公式与前轮完整推导见"}, {"t": "Link", "c": [["", [], []], [{"t": "Str", "c": "前轮主线审计"}], ["../../physical_consistency_20260911/PV_CORE_CLAIM_AUDIT_ZH.md", ""]]}, {"t": "Str", "c": "。"}, {"t": "SoftBreak"}, {"t": "RawInline", "c": ["tex", "\\phantomsection"]}, {"t": "RawInline", "c": ["tex", "\\label{source-norm}"]}]}], [{"t": "Para", "c": [{"t": "Link", "c": [["", [], []], [{"t": "Str", "c": "本轮一手版本/出版/最早代码审计"}], ["../../../evidence/MAJOR_SOURCE_NORM_AUDIT_20260912/AUDIT_ZH.md", ""]]}, {"t": "Str", "c": "及其SHA"}, {"t": "Space"}, {"t": "Str", "c": "manifest。官方来源包含"}, {"t": "Link", "c": [["", [], []], [{"t": "Str", "c": "2309v3"}], ["https://arxiv.org/abs/2309.12402v3", ""]]}, {"t": "Str", "c": "、"}, {"t": "Link", "c": [["", [], []], [{"t": "Str", "c": "正式PRD"}], ["https://journals.aps.org/prd/abstract/10.1103/PhysRevD.110.096001", ""]]}, {"t": "Str", "c": "和"}, {"t": "Link", "c": [["", [], []], [{"t": "Str", "c": "2403v1"}], ["https://arxiv.org/abs/2403.10772v1", ""]]}, {"t": "Str", "c": "。"}, {"t": "SoftBreak"}, {"t": "RawInline", "c": ["tex", "\\phantomsection"]}, {"t": "RawInline", "c": ["tex", "\\label{source-iteration}"]}]}], [{"t": "Para", "c": [{"t": "Link", "c": [["", [], []], [{"t": "Str", "c": "2403v1步骤身份补充"}], ["../../../evidence/MAJOR_SOURCE_NORM_AUDIT_20260912/ITERATION_SCOPE_ADDENDUM_ZH.md", ""]]}, {"t": "Str", "c": "，对应"}, {"t": "Link", "c": [["", [], []], [{"t": "Str", "c": "官方§8.5"}], ["https://arxiv.org/html/2403.10772v1#S8.SS5", ""]]}, {"t": "Str", "c": "。"}]}]]]}, {"t": "RawBlock", "c": ["tex", "\\clearpage"]}, {"t": "Header", "c": [2, ["数学附录近中心差分抵消局部下降的充分证明", [], []], [{"t": "Str", "c": "数学附录：近中心差分抵消：局部下降的充分证明"}]]}, {"t": "Para", "c": [{"t": "Str", "c": "原故障：L12在μ=9.5367431640625e−11、数值Newton减量约1.14536e−14时，两个完整障碍值相减给−6.59e−12。真实预期下降远小于各项对数值及密度内层解的舍入误差；简单的机器epsilon乘总值并未覆盖该内层误差。因而不能只调大噪声阈值，也不能把停止门槛从1e−14放宽。"}]}, {"t": "Para", "c": [{"t": "Str", "c": "本修补不修改物理约束、中心门槛或线性残差门槛。仅在普通联合问题、方向已通过原线性精度检查且原有下降读数不能接受时，使用Arb计算局部方向导数和曲率，并要求一个严格为正的充分下降下界。"}]}, {"t": "Header", "c": [3, ["为什么当前障碍是自协调的", [], []], [{"t": "Str", "c": "1."}, {"t": "Space"}, {"t": "Str", "c": "为什么当前障碍是自协调的"}]]}, {"t": "Para", "c": [{"t": "Str", "c": "正定矩阵上的−log"}, {"t": "Space"}, {"t": "Str", "c": "det"}, {"t": "Space"}, {"t": "Str", "c": "G沿实对称方向D满足"}]}, {"t": "Para", "c": [{"t": "Math", "c": [{"t": "DisplayMath"}, "\\phi''=\\operatorname{tr}B^2,\\quad\n\\phi'''=-2\\operatorname{tr}B^3,\\quad B=G^{-1/2}DG^{-1/2}."]}]}, {"t": "Para", "c": [{"t": "Str", "c": "实特征值的"}, {"t": "Math", "c": [{"t": "InlineMath"}, "\\ell_3"]}, {"t": "Str", "c": "范数不大于"}, {"t": "Math", "c": [{"t": "InlineMath"}, "\\ell_2"]}, {"t": "Str", "c": "范数，故"}, {"t": "Math", "c": [{"t": "InlineMath"}, "|\\phi'''|\\le2(\\phi'')^{3/2}"]}, {"t": "Str", "c": "。仿射限制保留该不等式。散射盘、FF盘和χ球可写为带常数块的正定矩阵行列式；一维矩误差区间也是两项线性对数障碍。加和保留自协调性；乘以不小于1的权重亦保留，因为"}, {"t": "Math", "c": [{"t": "InlineMath"}, "w\\le w^{3/2}"]}, {"t": "Str", "c": "。当前χ权重600/750/900均满足这一条件。线性目标不改变二阶、三阶导数。"}]}, {"t": "Para", "c": [{"t": "Str", "c": "密度的实际障碍是以下提升问题对v的严格凸极小化："}]}, {"t": "Para", "c": [{"t": "Math", "c": [{"t": "DisplayMath"}, "\\Phi(\\rho)=\\inf_{v_i>\\rho_i^2,\\;\\sum v_i^2<1}\n\\left[-\\sum_i\\log(v_i-\\rho_i^2)-\\log\\left(1-\\sum_i v_i^2\\right)\\right]."]}]}, {"t": "Para", "c": [{"t": "Str", "c": "每个"}, {"t": "Math", "c": [{"t": "InlineMath"}, "v_i-\\rho_i^2"]}, {"t": "Str", "c": "是2×2仿射正定矩阵的行列式；最后一项同样是球的log-det障碍。内层Hessian正定，且在边界发散，故严格内点时内层极小值唯一并存在。"}]}, {"t": "Para", "c": [{"t": "Str", "c": "沿"}, {"t": "Math", "c": [{"t": "InlineMath"}, "\\rho(t)"]}, {"t": "Str", "c": "记提升函数为F，最优v(t)满足"}, {"t": "Math", "c": [{"t": "InlineMath"}, "F_v=0"]}, {"t": "Str", "c": "。令"}, {"t": "Math", "c": [{"t": "InlineMath"}, "w=(\\rho',v')"]}, {"t": "Str", "c": "，由微分后的站立条件"}, {"t": "Math", "c": [{"t": "InlineMath"}, "F_{v\\rho}\\rho'+F_{vv}v'=0"]}, {"t": "Str", "c": "，有"}]}, {"t": "Para", "c": [{"t": "Math", "c": [{"t": "DisplayMath"}, "\\Phi''=D^2F[w,w],\\qquad \\Phi'''=D^3F[w,w,w]."]}]}, {"t": "Para", "c": [{"t": "Str", "c": "涉及"}, {"t": "Math", "c": [{"t": "InlineMath"}, "v''"]}, {"t": "Str", "c": "的混合二阶项被站立条件消去，涉及"}, {"t": "Math", "c": [{"t": "InlineMath"}, "v'''"]}, {"t": "Str", "c": "的一阶项被"}, {"t": "Math", "c": [{"t": "InlineMath"}, "F_v=0"]}, {"t": "Str", "c": "消去。因此提升函数的自协调不等式直接传给Φ；不需要把未经证明的旧sine秩结论转移到PV。"}]}, {"t": "Header", "c": [3, ["密度内层如何被区间包住", [], []], [{"t": "Str", "c": "2."}, {"t": "Space"}, {"t": "Str", "c": "密度内层如何被区间包住"}]]}, {"t": "Para", "c": [{"t": "Str", "c": "令"}, {"t": "Math", "c": [{"t": "InlineMath"}, "a_i=\\rho_i^2"]}, {"t": "Str", "c": "、"}, {"t": "Math", "c": [{"t": "InlineMath"}, "\\delta=1-\\sum_i v_i^2"]}, {"t": "Str", "c": "。站立条件给"}]}, {"t": "Para", "c": [{"t": "Math", "c": [{"t": "DisplayMath"}, "v_i=\\frac{a_i+\\sqrt{a_i^2+2\\delta}}2,\\quad\nF(\\delta)=\\delta+\\sum_i v_i^2-1=0."]}]}, {"t": "Para", "c": [{"t": "Str", "c": "若"}, {"t": "Math", "c": [{"t": "InlineMath"}, "r=1-\\sum_i\\rho_i^4>0"]}, {"t": "Str", "c": "、N为密度数，则"}]}, {"t": "Para", "c": [{"t": "Math", "c": [{"t": "DisplayMath"}, "1+N/2\\le F'(\\delta)=1+\\sum_i\\frac{v_i}{\\sqrt{a_i^2+2\\delta}}\\le1+N,"]}]}, {"t": "Para", "c": [{"t": "Str", "c": "从而根位于"}, {"t": "Math", "c": [{"t": "InlineMath"}, "[r/(1+N),r/(1+N/2)]"]}, {"t": "Str", "c": "。实现从该严格区间开始作区间Newton交集；即使提前停止，区间仍包含真实根，只有最终方向下降下界严格为正才接受。"}]}, {"t": "Para", "c": [{"t": "Str", "c": "以"}, {"t": "Math", "c": [{"t": "InlineMath"}, "d_i=\\delta/(2v_i)"]}, {"t": "Str", "c": "、"}, {"t": "Math", "c": [{"t": "InlineMath"}, "q_i=\\delta+2d_i^2"]}, {"t": "Str", "c": "表示，梯度为"}, {"t": "Math", "c": [{"t": "InlineMath"}, "4\\rho_iv_i/\\delta"]}, {"t": "Str", "c": "，Hessian为"}]}, {"t": "Para", "c": [{"t": "Math", "c": [{"t": "DisplayMath"}, "H=\\operatorname{diag}\\left(2/d_i+8a_i/q_i\\right)+bb^T,\n\\quad b_i=\\frac{-4\\rho_iv_i/q_i}{\\sqrt{1+\\sum_j\\delta/q_j}}."]}]}, {"t": "Para", "c": [{"t": "Str", "c": "该式来自隐式微分F(δ)=0或提升Hessian的Schur补；正对角与正半定秩一项使方向曲率可直接区间计算。"}]}, {"t": "Header", "c": [3, ["下降下界", [], []], [{"t": "Str", "c": "3."}, {"t": "Space"}, {"t": "Str", "c": "下降下界"}]]}, {"t": "Para", "c": [{"t": "Str", "c": "令完整局部目标为Ψ=障碍−cost/μ，"}, {"t": "Math", "c": [{"t": "InlineMath"}, "D=-\\Psi'(0)>0"]}, {"t": "Str", "c": "、"}, {"t": "Math", "c": [{"t": "InlineMath"}, "h=\\Psi''(0)\\ge0"]}, {"t": "Str", "c": "。对步长t>0及"}, {"t": "Math", "c": [{"t": "InlineMath"}, "r=t\\sqrt h<1"]}, {"t": "Str", "c": "，自协调性给"}]}, {"t": "Para", "c": [{"t": "Math", "c": [{"t": "DisplayMath"}, "\\Psi''(u)\\le\\frac{h}{(1-u\\sqrt h)^2}."]}]}, {"t": "Para", "c": [{"t": "Str", "c": "两次积分，并用"}, {"t": "Math", "c": [{"t": "InlineMath"}, "-r-\\log(1-r)\\le r^2/[2(1-r)]"]}, {"t": "Str", "c": "，得到"}]}, {"t": "Para", "c": [{"t": "Math", "c": [{"t": "DisplayMath"}, "\\boxed{\\Psi(0)-\\Psi(t)\\ge tD-\\frac{t^2h}{2(1-t\\sqrt h)}.}"]}]}, {"t": "Para", "c": [{"t": "Str", "c": "实现将long-double数逐个转为精确二进制有理数，重新计算Gram逆矩阵、各球/区间的方向导数、密度极小值区间、D和h；没有相减两个大对数值。所有局部锥严格性均须通过区间检查，右边的下端点须严格为正。Phase-I及额外渐近障碍不在此实现范围中，遇到它们不会授予此证书。"}]}, {"t": "Header", "c": [3, ["证明范围与检验", [], []], [{"t": "Str", "c": "4."}, {"t": "Space"}, {"t": "Str", "c": "证明范围与检验"}]]}, {"t": "Para", "c": [{"t": "Str", "c": "缓存盘/χ裕量定义其局部一致的平移二次锥；Gram条目、方向及密度坐标按明确的二进制数处理。这是该局部数值锥模型的下降证明，"}, {"t": "Strong", "c": [{"t": "Str", "c": "不是原H精确驻点、缓存到原始坐标映射误差或连续物理振幅的证书"}]}, {"t": "Str", "c": "。完成步骤后，数值中心仍须满足原门槛，完整C仍须回到原H/current作独立primal和支撑审计。"}]}, {"t": "Para", "c": [{"t": "Str", "c": "已有独立测试扩展了两项内容：一维球障碍−log(1−x²)减线性目标的精确log1p下降量，验证正向界不超过真实下降、反向不得通过；完整小型联合模型的有限变分同时检查密度/Gram/FF/矩/χ贡献。所有旧测试断言通过AST等价折行保留，仍只有三个测试文件。"}]}, {"t": "Para", "c": [{"t": "Str", "c": "原始失败、失败点/缓存、修改前源字节及RED/GREEN日志均留存。这个修补解决的是可计算的下降量抵消，未将未收敛点改名为中心，也未把任何物理容差调大。"}]}, {"t": "RawBlock", "c": ["tex", "\\clearpage\n\\begin{landscape}\n\\section*{附图1：未改动的IR对照}\n\\addcontentsline{toc}{section}{附图1：未改动的IR对照}\n\\vfill\n\\begin{center}\\includegraphics[width=0.98\\linewidth]{figures/fig7_IR.pdf}\\end{center}\n\\begin{center}\\small \\href{../../physical_consistency_20260911/PV_C3_fig7/profiles.pdf}{原始图件}\\end{center}\n\\vfill\n\\end{landscape}\n\\clearpage\n\\begin{landscape}\n\\section*{附图2：Fig.8 有限内外界}\n\\addcontentsline{toc}{section}{附图2：Fig.8 有限内外界}\n\\vfill\n\\begin{center}\\includegraphics[width=0.98\\linewidth]{figures/fig8_regions.pdf}\\end{center}\n\\begin{center}\\small \\href{../refined_regions/regions.pdf}{原始图件}\\end{center}\n\\vfill\n\\end{landscape}\n\\clearpage\n\\section*{附图3：Fig.9 P1相位}\n\\addcontentsline{toc}{section}{附图3：Fig.9 P1相位}\n\\vfill\n\\begin{center}\\includegraphics[width=0.98\\linewidth]{figures/fig9.pdf}\\end{center}\n\\begin{center}\\small \\href{../refined_phases/fig9.pdf}{原始图件}\\end{center}\n\\vfill\n\\clearpage\n\\begin{landscape}\n\\section*{附图4：Fig.10 S0/S2比较}\n\\addcontentsline{toc}{section}{附图4：Fig.10 S0/S2比较}\n\\vfill\n\\begin{center}\\includegraphics[width=0.98\\linewidth]{figures/fig10.pdf}\\end{center}\n\\begin{center}\\small \\href{../refined_phases/fig10.pdf}{原始图件}\\end{center}\n\\vfill\n\\end{landscape}\n\\clearpage\n\\begin{landscape}\n\\section*{附图5：三代表非弹性}\n\\addcontentsline{toc}{section}{附图5：三代表非弹性}\n\\vfill\n\\begin{center}\\includegraphics[width=0.98\\linewidth]{figures/inelasticities.pdf}\\end{center}\n\\begin{center}\\small \\href{../refined_phases/inelasticities.pdf}{原始图件}\\end{center}\n\\vfill\n\\end{landscape}\n\\clearpage\n\\begin{landscape}\n\\section*{附图6：散射强度、FF与电流谱}\n\\addcontentsline{toc}{section}{附图6：散射强度、FF与电流谱}\n\\vfill\n\\begin{center}\\includegraphics[width=0.98\\linewidth]{figures/rho_mechanism.pdf}\\end{center}\n\\begin{center}\\small \\href{../refined_phases/rho_mechanism.pdf}{原始图件}\\end{center}\n\\vfill\n\\end{landscape}\n\\clearpage\n\\section*{附图7：Fig.11 五组M/L比较}\n\\addcontentsline{toc}{section}{附图7：Fig.11 五组M/L比较}\n\\vfill\n\\begin{center}\\includegraphics[width=0.98\\linewidth]{figures/fig11.pdf}\\end{center}\n\\begin{center}\\small \\href{../F_refined/fig11.pdf}{原始图件}\\end{center}\n\\vfill\n\\clearpage\n\\begin{landscape}\n\\section*{附图8：五组M/L非弹性}\n\\addcontentsline{toc}{section}{附图8：五组M/L非弹性}\n\\vfill\n\\begin{center}\\includegraphics[width=0.98\\linewidth]{figures/fig11_eta.pdf}\\end{center}\n\\begin{center}\\small \\href{../F_refined/fig11_eta.pdf}{原始图件}\\end{center}\n\\vfill\n\\end{landscape}"]}]}